{
  "name": "@ruixe/modbus-simulator",
  "version": "1.1.0",
  "description": "A free Modbus Device Simulator built with Next.js. Provides a real-time dashboard with paginated register tables, communication logs, and configurable TCP/RTU server settings.",
  "bin": {
    "modbus-simulator": "scripts/cli.mjs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "node scripts/cli.mjs",
    "format": "prettier --write .",
    "lint": "eslint",
    "format-lint": "npm run format && npm run lint",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "vitest run && playwright test",
    "prepare": "husky",
    "publish:npm": "node scripts/publish.mjs",
    "publish:npm:dry-run": "node scripts/publish.mjs --dry-run"
  },
  "keywords": [
    "modbus",
    "modbus-tcp",
    "modbus-rtu",
    "simulator",
    "plc",
    "industrial",
    "automation",
    "nextjs"
  ],
  "author": "Ruixe Wolf <ruixewolf@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RuixeWolf/modbus-simulator.git"
  },
  "bugs": {
    "url": "https://github.com/RuixeWolf/modbus-simulator/issues"
  },
  "homepage": "https://github.com/RuixeWolf/modbus-simulator#readme",
  "engines": {
    "node": ">=20.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@heroui/react": "^3.2.4",
    "@heroui/styles": "^3.2.4",
    "@iconify-json/lucide": "^1.2.129",
    "@iconify/react": "^6.0.2",
    "framer-motion": "^13.2.0",
    "i18next": "^26.4.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "modbus-serial": "^8.0.25",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "^17.0.13",
    "serialport": "^13.0.0",
    "zod": "^4.5.4",
    "zod-openapi": "^5.4.2"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.7",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@next/eslint-plugin-next": "^16.3.4",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.4.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
